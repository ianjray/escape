.POSIX:
.SUFFIXES:
.SUFFIXES: .c .o .uto

VERSION    = 1.0.0

CC         = @CC@
CCOV       = gcov
CFLAGS     = @CFLAGS@
CFLAGS_COV = @CFLAGS_COV@
CFLAGS_SAN = @CFLAGS_SAN@
INCLUDEDIR = @PREFIX@/include
LD         = @LD@
LIBDIR     = @PREFIX@/lib
PREFIX     = @PREFIX@

.PHONY: all
all: libesc.a

libesc.a: escape.o
	$(LD) -r $^ -o $@

.c.o:
	$(CC) $(CFLAGS) -DNDEBUG -c $< -o $@

.c.uto:
	$(CC) $(CFLAGS) $(CFLAGS_COV) $(CFLAGS_SAN) -I. -c $^ -o $@

escape.coverage: escape.uto tests/test_escape.c
	$(CC) $(CFLAGS) $(CFLAGS_COV) $(CFLAGS_SAN) -I. $^ -o $@
	./$@
	$(CCOV) escape.c
	! grep "#####" escape.c.gcov |grep -ve "// UNREACHABLE$$"

libesc.pc:
	( echo 'Name: libesc' ;\
	echo 'Version: $(VERSION)' ;\
	echo 'Description: Simple shell-style escape of backslash and newline' ;\
	echo 'prefix=$(PREFIX)' ;\
	echo 'exec_prefix=$${prefix}' ;\
	echo 'includedir=$${prefix}/include' ;\
	echo 'libdir=$${prefix}/lib' ;\
	echo 'Cflags: -I$${includedir}' ;\
	echo 'Libs: -L$${libdir} -lesc' ) > $@

.PHONY: test
test: escape.coverage

.PHONY: install
install: escape.h libesc.a libesc.pc
	mkdir -p $(DESTDIR)$(INCLUDEDIR)/libesc
	mkdir -p $(DESTDIR)$(LIBDIR)/pkgconfig
	install -m644 escape.h $(DESTDIR)$(INCLUDEDIR)/libesc/escape.h
	install -m644 libesc.a $(DESTDIR)$(LIBDIR)/libesc.a
	install -m644 libesc.pc $(DESTDIR)$(LIBDIR)/pkgconfig/libesc.pc

.PHONY: uninstall
uninstall:
	rm -f $(DESTDIR)$(INCLUDEDIR)/libesc/escape.h
	rm -f $(DESTDIR)$(LIBDIR)/libesc.a
	rm -f $(DESTDIR)$(LIBDIR)/pkgconfig/libesc.pc

.PHONY: clean
clean:
	rm -f *.o **/*.o *.uto **/*.uto *.gc?? **/*.gc?? *.coverage
	rm -f libesc.a libesc.pc
	rm -f test_readme*

.PHONY: distclean
distclean: clean
	rm -f Makefile config.status
